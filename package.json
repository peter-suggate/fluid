{
  "name": "fluid-lab-webgpu",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check:svo-fluid-coverage": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_WEBGPU_BACKEND=${WEBGPU_BACKEND:-metal} node --import tsx tools/check-svo-fluid-coverage-compact.ts",
    "check:scenery": "node --import tsx tools/check-scenery.ts",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "npm run build:physics-wasm && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "build:physics-wasm": "node tools/wasm/build.mjs",
    "build:physics-wasm:single": "node tools/wasm/build.mjs --single",
    "build:physics-wasm:scalar": "node tools/wasm/build.mjs --scalar",
    "build:physics-wasm:simd": "node tools/wasm/build.mjs --simd",
    "build:physics-wasm:threaded": "node tools/wasm/build.mjs --threaded",
    "check:physics-wasm": "node tools/wasm/check-artifacts.mjs",
    "check:physics-wasm:serving": "node tools/wasm/check-serving.mjs",
    "test:physics-wasm:node": "node tools/wasm/load-module.mjs",
    "test:physics-wasm:threaded": "node --import tsx tools/wasm/threaded-parity.ts",
    "check:types": "tsc --noEmit",
    "check:gpu-compilation-policy": "node --import tsx --test tests/gpu-compilation-policy.test.ts tests/gpu-compilation-manager.test.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node tools/start-production.mjs",
    "deploy:site": "npm run build && node tools/package-chatgpt-site.mjs",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --import tsx tools/run-feature-tests.ts",
    "test:webgpu:svo-dry-render": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js node --import tsx tools/run-svo-dry-render-smoke.ts",
    "test:webgpu:svo-live-voxelization": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js node --import tsx tools/run-svo-live-voxelization-smoke.ts",
    "probe:svo:radiance-slot-space": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js node --import tsx tools/probe-svo-radiance-slot-space-dawn.ts",
    "test:webgpu:svo-capacity-sweep": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js node --import tsx tools/run-svo-capacity-sweep-smoke.ts",
    "test:webgpu:hero-garden-hose": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_SVO_DRY_SMOKE_SCENE=hero-garden-hose FLUID_SVO_DRY_SMOKE_WIDTH=800 FLUID_SVO_DRY_SMOKE_HEIGHT=460 node --import tsx tools/run-svo-dry-render-smoke.ts",
    "test:webgpu:hero-garden-hose-x10": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_SVO_DRY_SMOKE_SCENE=hero-garden-hose-x10 FLUID_SVO_DRY_SMOKE_WIDTH=800 FLUID_SVO_DRY_SMOKE_HEIGHT=460 node --import tsx tools/run-svo-dry-render-smoke.ts",
    "test:dawn:sunlight": "FLUID_SVO_SUNLIGHT_COMPARISON_DIR=artifacts/backdrop-svo/sunlight-check FLUID_SVO_DRY_SMOKE_CONE_SCALE=1 npm run test:webgpu:hero-garden-hose-x10 && node --import tsx tools/check-svo-sunlight-captures.ts artifacts/backdrop-svo/sunlight-check",
    "gate:hero-fidelity": "node --import tsx tools/hero-fidelity-gate.ts",
    "gate:hero-fidelity:overlay": "FLUID_HERO_FIDELITY_MODE=overlay node --import tsx tools/hero-fidelity-gate.ts",
    "plate:crops": "node --import tsx tools/crop-hero-plate.ts",
    "solve:hero-camera": "node --import tsx tools/solve-hero-camera.ts",
    "capture:hero-grade-raw": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_SVO_DRY_SMOKE_SCENE=hero-garden-hose FLUID_SVO_DRY_SMOKE_WIDTH=836 FLUID_SVO_DRY_SMOKE_HEIGHT=470 FLUID_SVO_DRY_SMOKE_RAW=$PWD/artifacts/hero-grade/frame.raw FLUID_SVO_DRY_SMOKE_PNG=$PWD/artifacts/hero-grade/frame.png FLUID_SVO_DRY_SMOKE_OUT=$PWD/artifacts/hero-grade/smoke.json node --import tsx tools/run-svo-dry-render-smoke.ts",
    "solve:hero-grade": "npm run capture:hero-grade-raw && node --import tsx tools/solve-hero-grade.ts",
    "test:webgpu:hero-floor-far": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_SVO_DRY_FRAME_SCENE_MODULE=tools/hero-floor-far-scene.ts FLUID_SVO_DRY_FRAME_TRAVERSAL=raster-primary FLUID_SVO_DRY_FRAME_SHADING=split FLUID_SVO_DRY_FRAME_SCREEN_SPACE_PIXELS=${FLUID_SVO_DRY_FRAME_SCREEN_SPACE_PIXELS:-3} FLUID_SVO_DRY_FRAME_CONE_FANOUT=1 FLUID_SVO_DRY_FRAME_TIMING=gpu FLUID_SVO_DRY_FRAME_PHASE_TRACE=1 FLUID_SVO_DRY_FRAME_WIDTH=800 FLUID_SVO_DRY_FRAME_HEIGHT=460 FLUID_SVO_DRY_FRAME_BUDGET_MS=${FLUID_SVO_DRY_FRAME_BUDGET_MS:-8} FLUID_SVO_DRY_FRAME_OUT=${FLUID_SVO_DRY_FRAME_OUT:-/tmp/svo-bench/hero-floor-far.json} node --import tsx tools/benchmark-svo-dry-frame-gpu.ts",
    "test:webgpu:hero-floor-far-4x": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_SVO_DRY_FRAME_SCENE_MODULE=tools/hero-floor-far-scene.ts FLUID_SVO_DRY_FRAME_TRAVERSAL=raster-primary FLUID_SVO_DRY_FRAME_SHADING=split FLUID_SVO_DRY_FRAME_SCREEN_SPACE_PIXELS=${FLUID_SVO_DRY_FRAME_SCREEN_SPACE_PIXELS:-3} FLUID_SVO_DRY_FRAME_CONE_FANOUT=1 FLUID_SVO_DRY_FRAME_TIMING=gpu FLUID_SVO_DRY_FRAME_PHASE_TRACE=1 FLUID_SVO_DRY_FRAME_WIDTH=1600 FLUID_SVO_DRY_FRAME_HEIGHT=920 FLUID_SVO_DRY_FRAME_BUDGET_MS=${FLUID_SVO_DRY_FRAME_BUDGET_MS:-17} FLUID_SVO_DRY_FRAME_OUT=${FLUID_SVO_DRY_FRAME_OUT:-/tmp/svo-bench/hero-floor-far-4x.json} node --import tsx tools/benchmark-svo-dry-frame-gpu.ts",
    "test:webgpu:hero-floor-sky": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_SVO_DRY_FRAME_SCENE_MODULE=tools/hero-floor-sky-scene.ts FLUID_SVO_DRY_FRAME_TRAVERSAL=raster-primary FLUID_SVO_DRY_FRAME_SHADING=split FLUID_SVO_DRY_FRAME_SCREEN_SPACE_PIXELS=${FLUID_SVO_DRY_FRAME_SCREEN_SPACE_PIXELS:-3} FLUID_SVO_DRY_FRAME_CONE_FANOUT=1 FLUID_SVO_DRY_FRAME_TIMING=gpu FLUID_SVO_DRY_FRAME_PHASE_TRACE=1 FLUID_SVO_DRY_FRAME_WIDTH=800 FLUID_SVO_DRY_FRAME_HEIGHT=460 FLUID_SVO_DRY_FRAME_BUDGET_MS=${FLUID_SVO_DRY_FRAME_BUDGET_MS:-1.1} FLUID_SVO_DRY_FRAME_OUT=${FLUID_SVO_DRY_FRAME_OUT:-/tmp/svo-bench/hero-floor-sky.json} node --import tsx tools/benchmark-svo-dry-frame-gpu.ts",
    "benchmark:svo-fixed-overhead": "npm run test:webgpu:hero-floor-sky && npm run test:webgpu:hero-floor-far && npm run test:webgpu:hero-floor-far-4x",
    "benchmark:spray": "node --import tsx tools/benchmark-secondary-particles.ts",
    "benchmark:rigid": "node --import tsx tools/run-rigid-benchmarks.ts",
    "profile:mini-dam-xctrace": "node --import tsx tools/profile-mini-dam-xctrace.ts --frames=2",
    "profile:large-dam-xctrace": "node --import tsx tools/profile-mini-dam-xctrace.ts --lane=large --frames=2",
    "profile:mini-dam-xctrace:occupancy": "node --import tsx tools/profile-mini-dam-xctrace.ts --counters --isolate-pass-labels --steps=240",
    "profile:mini-dam-xctrace:micro": "node --import tsx tools/profile-mini-dam-xctrace.ts --counters --counter-seconds=3 --steps=240 --isolate-pass-labels --gpu-report-only --discard-tables --discard-trace",
    "profile:svo-render-xctrace": "node --import tsx tools/profile-svo-render-xctrace.ts",
    "profile:hero-garden-hose-xctrace": "node --import tsx tools/profile-svo-render-xctrace.ts --scene=hero-garden-hose --refinement=3 --traversal=canonical-parametric --shading=split --resolution=800x460 --counter-seconds=6 --construction-seconds=420 --variant=depth3 --out=artifacts/xctrace-hero-garden-hose-depth3",
    "render:xctrace-report": "node --import tsx tools/rerender-xctrace-report.ts",
    "compact:xctrace-counters": "node --import tsx tools/compact-xctrace-counters.ts",
    "cleanup:artifacts": "node --import tsx tools/cleanup-profile-artifacts.ts",
    "benchmark:svo-derived": "node --import tsx tools/benchmark-svo-derived-hierarchy.ts",
    "benchmark:svo-continuation-gpu": "node --import tsx tools/benchmark-svo-continuation-gpu.ts",
    "benchmark:svo-wide-gpu": "node --import tsx tools/benchmark-svo-wide-fanout-gpu.ts",
    "benchmark:svo-traversal": "node --import tsx tools/benchmark-svo-traversal-gpu.ts",
    "benchmark:svo-render-stages": "node --import tsx tools/benchmark-svo-render-stages.ts",
    "benchmark:svo-silhouette-refinement": "node --import tsx tools/benchmark-svo-dry-frame-gpu.ts",
    "benchmark:svo-record-scale": "WEBGPU_NODE_MODULE=$PWD/node_modules/webgpu/index.js FLUID_SVO_DRY_FRAME_RECORD_SCALE=${FLUID_SVO_DRY_FRAME_RECORD_SCALE:-1,10} node --import tsx tools/benchmark-svo-dry-frame-gpu.ts",
    "report:svo-scenes": "node --import tsx tools/report-svo-scene-coverage.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "check:module-boundaries": "node --import tsx tools/check-module-boundaries.ts",
    "test:physics-wasm:world": "node --import tsx --test tools/wasm/full-world-flow.test.ts",
    "test:physics-wasm:world3d": "node --import tsx tools/wasm/node-world3d-flow.ts",
    "test:physics-wasm:world3d:sustained": "node --import tsx tools/wasm/node-world3d-flow.ts --ui-default-frames=60",
    "test:physics-wasm:adapter-world3d": "node --import tsx --test tools/wasm/adapter-world3d-flow.test.ts",
    "generate:uniform-geometric-contract": "node --import tsx tools/wasm/generate-uniform-geometric-contract.ts",
    "check:uniform-geometric-contract": "node --import tsx tools/wasm/generate-uniform-geometric-contract.ts --check",
    "test:uniform-lab:inflow": "node --import tsx tools/wasm/uniform-lab-inflow.ts",
    "test:uniform-lab:scenes": "node --import tsx tools/wasm/uniform-lab-scenes.ts",
    "test:uniform-pressure:2d": "node --import tsx tools/wasm/uniform-pressure-stability.ts"
  },
  "dependencies": {
    "box3d-wasm": "0.2.0",
    "lucide-react": "^1.31.0",
    "mediabunny": "^1.50.8",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@webgpu/types": "0.1.69",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "webgpu": "^0.6.0",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
