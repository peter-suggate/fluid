+// Optional diagnostic-only bounded run; the authored dt and physics are unchanged.
+void referenceHeadlessRun(int steps, const char* path, int every) {
+  std::ofstream out(path); out << std::setprecision(17);
+  if (!out || steps < 0 || every <= 0) throw std::runtime_error("Invalid reference output configuration");
+  for (int step=0; step<=steps; ++step) {
+    if (step % every == 0 || step == steps) {
+      const auto& scene=*g_executable_simulation->referenceScene();
+      out << "{\"step\":" << step << ",\"time_s\":" << step*g_dt
+          << ",\"dt_s\":" << g_dt << ",\"units\":\"CGS\",\"softParticles\":"
+          << scene.getNumSoftElastoParticles() << ",\"elastoParticles\":" << scene.getNumElastoParticles()
+          << ",\"fluidParticles\":" << scene.getNumFluidParticles();
+      auto field=[&](const char* name,const VectorXs& values) {
+        out << ",\"" << name << "\":[";
+        for (int i=0; i<values.size(); ++i) {if(i)out << ',';out << values[i];}
+        out << ']';
+      };
+      field("x",scene.getX());field("v",scene.getV());field("fluidV",scene.getFluidV());
+      field("waterVolume",scene.getFluidVol());field("volume",scene.getVol());field("solidFraction",scene.getVolumeFraction());
+      out << "}\n";out.flush();
+      if(!out)throw std::runtime_error("Reference output write failed");
+    }
+    if(step<steps)g_executable_simulation->stepSystem(g_dt);
+  }
+}
