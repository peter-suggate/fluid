diff --git a/rust/crates/fluid-core/examples/fig9_pressure_audit.rs b/rust/crates/fluid-core/examples/fig9_pressure_audit.rs
new file mode 100644
--- /dev/null
+++ b/rust/crates/fluid-core/examples/fig9_pressure_audit.rs
@@ -0,0 +1,17 @@
+use fluid_core::uniform_geometric::{pressure::Pressure, UniformGeometricOptions};
+fn main() {
+ let r:serde_json::Value=serde_json::from_str(&std::fs::read_to_string("/tmp/fig9-pressure.json").unwrap()).unwrap();
+ for (name,full,v,sweeps) in [("full1",1.,0.,6.),("full2",2.,0.,6.),("full3",3.,0.,6.),("v1",0.,1.,6.),("v7",0.,7.,6.),("v30",0.,30.,6.),("smooth",0.,1.,1000.)] {
+ let mut p=Pressure::new(serde_json::from_value(r["dims"].clone()).unwrap(),serde_json::from_value(r["h"].clone()).unwrap()).unwrap();
+ p.levels[0].phi=serde_json::from_value(r["phi"].clone()).unwrap();
+ p.levels[0].topology=serde_json::from_value(r["topology"].clone()).unwrap();
+ p.levels[0].minimum=serde_json::from_value(r["minimum"].clone()).unwrap();
+ p.levels[0].rhs=serde_json::from_value(r["rhs"].clone()).unwrap();
+ if let Ok(n)=std::env::var("AUDIT_LEVELS") {p.levels.truncate(n.parse().unwrap());}
+ let mut o:UniformGeometricOptions=serde_json::from_value(r["options"].clone()).unwrap();
+ o.pressure_full_cycles=full; o.pressure_v_cycles=v; o.pressure_sweeps=sweeps; o.pressure_residual_tolerance=0.;
+ p.solve(&o,r["dt"].as_f64().unwrap() as f32,r["rho"].as_f64().unwrap() as f32,false);
+ println!("{} {:?} maxima {:?}",name,p.receipt,p.levels.iter().map(|l| l.p.iter().copied().map(f32::abs).fold(0.,f32::max)).collect::<Vec<_>>());
+ if name=="full2" { std::fs::write("/tmp/fig9-levels.json",serde_json::to_string(&p.levels.iter().map(|l|serde_json::json!({"dims":l.dims,"phi":l.phi,"topology":l.topology,"p":l.p,"rhs":l.rhs,"min":l.minimum})).collect::<Vec<_>>()).unwrap()).unwrap(); }
+ }
+}
