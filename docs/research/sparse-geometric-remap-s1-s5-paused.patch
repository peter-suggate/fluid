+                let f01 = field.psi[ids[2]];
+                let f11 = field.psi[ids[3]];
+                let fx00 = field.dx[ids[0]];
+                let fx10 = field.dx[ids[1]];
+                let fx01 = field.dx[ids[2]];
+                let fx11 = field.dx[ids[3]];
