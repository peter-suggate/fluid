+                        minimum[0] = minimum[0].min(u);
+                        maximum[0] = maximum[0].max(u);
+                    }
+                }
+                for i in 0..3 {
+                    for j in 0..4 {
+                        let v = -3.0 * (b[i + 1][j] - b[i][j]);
+                        minimum[1] = minimum[1].min(v);
+                        maximum[1] = maximum[1].max(v);
