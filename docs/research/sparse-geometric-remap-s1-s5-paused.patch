+    fn active_streamfunction_patch(
+        &self,
+        field: &StreamfunctionVelocity2d,
+        point: [f64; 2],
+    ) -> Option<usize> {
+        let lookup = [
+            point[0].min(f32::from_bits((self.dimensions[0] as f32).to_bits() - 1) as f64),
+            point[1].min(f32::from_bits((self.dimensions[1] as f32).to_bits() - 1) as f64),
+        ];
+        let lattice_x = lookup[0].floor() as usize;
+        let lattice_y = lookup[1].floor() as usize;
+        let alternate_x = (point[0] == point[0].round() && point[0] > 0.0)
+            .then_some(lattice_x.saturating_sub(1));
+        let alternate_y = (point[1] == point[1].round() && point[1] > 0.0)
+            .then_some(lattice_y.saturating_sub(1));
+        let xs = [Some(lattice_x), alternate_x];
+        let ys = [Some(lattice_y), alternate_y];
+        ys.into_iter().flatten().find_map(|y| {
+            xs.into_iter()
+                .flatten()
+                .map(|x| x + self.lattice_dimensions[0] * y)
+                .find(|&at| field.active_lattice[at])
+        })
     }

