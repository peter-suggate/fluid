+                // corner. These are the 4x4 Bernstein controls for exactly
+                // that bicubic Hermite polynomial (first index is x).
+                let b = [
+                    [f00, f00 + fy00 / 3.0, f01 - fy01 / 3.0, f01],
+                    [
+                        f00 + fx00 / 3.0,
+                        f00 + fx00 / 3.0 + fy00 / 3.0,
+                        f01 + fx01 / 3.0 - fy01 / 3.0,
+                        f01 + fx01 / 3.0,
+                    ],
