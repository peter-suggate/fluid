+#[derive(Clone, Copy, Debug)]
+struct ReachBox {
+    minimum: [f64; 2],
+    maximum: [f64; 2],
+}
+
+impl ReachBox {
+    fn union(self, other: Self) -> Self {
+        Self {
+            minimum: [
+                self.minimum[0].min(other.minimum[0]),
+                self.minimum[1].min(other.minimum[1]),
+            ],
+            maximum: [
+                self.maximum[0].max(other.maximum[0]),
+                self.maximum[1].max(other.maximum[1]),
+            ],
+        }
+    }
+}
+
+#[derive(Clone, Debug)]
+struct MaterialTraceBand {
+    cells: Vec<bool>,
+    time_slices: usize,
+    patch_visits: usize,
+    within_slice_expansions: usize,
+    support_boundary_hits: usize,
+}
+
+fn next_down(value: f64) -> f64 {
+    if !value.is_finite() || value == f64::NEG_INFINITY {
+        return value;
+    }
+    if value == 0.0 {
+        return -f64::from_bits(1);
+    }
+    if value > 0.0 {
+        f64::from_bits(value.to_bits() - 1)
+    } else {
+        f64::from_bits(value.to_bits() + 1)
+    }
+}
+
+fn next_up(value: f64) -> f64 {
+    if !value.is_finite() || value == f64::INFINITY {
+        return value;
+    }
+    if value == 0.0 {
+        return f64::from_bits(1);
+    }
+    if value >= 0.0 {
+        f64::from_bits(value.to_bits() + 1)
+    } else {
+        f64::from_bits(value.to_bits() - 1)
+    }
+}
+
+fn shifted_reach_bound(value: f64, displacement: f64, lower: bool) -> f64 {
+    let shifted = value + displacement;
+    if displacement == 0.0 {
+        shifted
+    } else if lower {
+        next_down(shifted)
+    } else {
+        next_up(shifted)
+    }
+}
+
+fn patch_scan_bounds(bounds: ReachBox, dimensions: [usize; 2]) -> ([usize; 2], [usize; 2]) {
+    let mut minimum = [0; 2];
+    let mut maximum = [0; 2];
+    for axis in 0..2 {
+        let lo = bounds.minimum[axis].floor().max(0.0) as usize;
+        // Include the patch on the negative side of an exact lattice boundary
+        // while forming velocity bounds. The two represented traces agree on
+        // the boundary, and including both is the conservative choice.
+        minimum[axis] = lo.saturating_sub(1).min(dimensions[axis]);
+        maximum[axis] = (bounds.maximum[axis].ceil() as usize)
+            .saturating_add(1)
+            .min(dimensions[axis]);
+    }
+    (minimum, maximum)
+}
+
+fn patch_touches_closed_box(x: usize, y: usize, bounds: ReachBox) -> bool {
+    x as f64 <= bounds.maximum[0]
+        && (x + 1) as f64 >= bounds.minimum[0]
+        && y as f64 <= bounds.maximum[1]
+        && (y + 1) as f64 >= bounds.minimum[1]
+}
+
+fn patch_overlaps_open_box(x: usize, y: usize, bounds: ReachBox) -> bool {
+    bounds.maximum[0] > x as f64
+        && bounds.minimum[0] < (x + 1) as f64
+        && bounds.maximum[1] > y as f64
+        && bounds.minimum[1] < (y + 1) as f64
+}
+
+fn closed_world_domain_sides(graph: &Graph) -> [bool; 4] {
+    // x-minimum, x-maximum, y-minimum, y-maximum. Clamping is justified only
+    // where every represented physical segment is explicitly ClosedWorld.
+    let mut seen = [false; 4];
+    let mut closed = [true; 4];
+    for face in &graph.subfaces {
+        let side = if face.axis == 0 && face.center[0] == 0.0 {
+            Some(0)
+        } else if face.axis == 0 && face.center[0] == graph.dimensions[0] {
+            Some(1)
+        } else if face.axis == 1 && face.center[1] == 0.0 {
+            Some(2)
+        } else if face.axis == 1 && face.center[1] == graph.dimensions[1] {
+            Some(3)
+        } else {
+            None
+        };
+        if let Some(side) = side {
+            seen[side] = true;
+            closed[side] &= graph.rows[face.row_id as usize].kind == RowKind::ClosedWorld;
+        }
+    }
+    std::array::from_fn(|side| seen[side] && closed[side])
+}
+
+fn clamp_closed_world_reach(
+    graph: &Graph,
+    closed_sides: [bool; 4],
+    mut bounds: ReachBox,
+    support_boundary_hits: &mut usize,
+) -> ReachBox {
+    let upper = [graph.dimensions[0] as f64, graph.dimensions[1] as f64];
+    if bounds.minimum[0] < 0.0 {
+        if !closed_sides[0] {
+            *support_boundary_hits += 1;
+        }
+        bounds.minimum[0] = 0.0;
+    }
+    if bounds.maximum[0] > upper[0] {
+        if !closed_sides[1] {
+            *support_boundary_hits += 1;
+        }
+        bounds.maximum[0] = upper[0];
+    }
+    if bounds.minimum[1] < 0.0 {
+        if !closed_sides[2] {
+            *support_boundary_hits += 1;
+        }
+        bounds.minimum[1] = 0.0;
+    }
+    if bounds.maximum[1] > upper[1] {
+        if !closed_sides[3] {
+            *support_boundary_hits += 1;
+        }
+        bounds.maximum[1] = upper[1];
+    }
+    bounds
+}
+
+fn conservative_material_trace_band(
+    graph: &Graph,
+    fields: &Fields,
+    tracer: &FaceConsistentVelocity2d,
+    dt: f64,
+) -> Result<MaterialTraceBand, ValidationError> {
+    let dimensions = [graph.dimensions[0] as usize, graph.dimensions[1] as usize];
+    if dimensions[0] == 0
+        || dimensions[1] == 0
+        || dimensions[0] as f32 != graph.dimensions[0]
+        || dimensions[1] as f32 != graph.dimensions[1]
+    {
+        return Err(ValidationError(
+            "cellwise remap material trace band requires integral 2-D dimensions".into(),
+        ));
+    }
+    let patch_bounds = tracer.streamfunction_patch_velocity_bounds()?;
+    let closed_sides = closed_world_domain_sides(graph);
+    if patch_bounds.len() != dimensions[0] * dimensions[1] {
+        return Err(ValidationError(
+            "cellwise remap material trace band has an invalid patch lattice".into(),
+        ));
+    }
+    let global_speed = patch_bounds
+        .iter()
+        .flatten()
+        .map(|bounds| {
+            let ux = bounds.minimum[0].abs().max(bounds.maximum[0].abs());
+            let uy = bounds.minimum[1].abs().max(bounds.maximum[1].abs());
+            ux.hypot(uy)
+        })
+        .fold(0.0_f64, f64::max);
+    if !global_speed.is_finite() {
+        return Err(ValidationError(
+            "cellwise remap material trace band has non-finite velocity bounds".into(),
+        ));
+    }
+    let bounded_speed = if global_speed == 0.0 {
+        0.0
+    } else {
+        next_up(global_speed)
+    };
+    let time_slices = (4.0 * dt * bounded_speed).ceil().max(1.0) as usize;
+    if time_slices > 4096 {
+        return Err(ValidationError(format!(
+            "cellwise remap material trace band requires {time_slices} time slices, above 4096"
+        )));
+    }
+    let h = dt / time_slices as f64;
+    let lattice_index = |x: usize, y: usize| x + dimensions[0] * y;
+    let mut state = vec![None::<ReachBox>; patch_bounds.len()];
+    for (cell_index, cell) in graph.cells.iter().enumerate() {
+        if fields.density[cell_index] <= 0.0 {
+            continue;
+        }
+        let liquid = donor_liquid_polygon(graph, fields, cell_index);
+        for y in cell.minimum[1] as usize..cell.maximum[1] as usize {
+            for x in cell.minimum[0] as usize..cell.maximum[0] as usize {
+                let at = lattice_index(x, y);
+                if patch_bounds[at].is_none() {
+                    return Err(ValidationError(
+                        "cellwise remap liquid donor is outside streamfunction support".into(),
+                    ));
+                }
+                let clipped = clip_rectangle(
+                    &liquid,
+                    [x as f64, y as f64],
+                    [(x + 1) as f64, (y + 1) as f64],
+                );
+                if signed_area(&clipped).abs() <= GEOMETRY_EPS {
+                    continue;
+                }
+                let bounds = ReachBox {
+                    minimum: [
+                        clipped
+                            .iter()
+                            .map(|point| point[0])
+                            .fold(f64::INFINITY, f64::min),
+                        clipped
+                            .iter()
+                            .map(|point| point[1])
+                            .fold(f64::INFINITY, f64::min),
+                    ],
+                    maximum: [
+                        clipped
+                            .iter()
+                            .map(|point| point[0])
+                            .fold(f64::NEG_INFINITY, f64::max),
+                        clipped
+                            .iter()
+                            .map(|point| point[1])
+                            .fold(f64::NEG_INFINITY, f64::max),
+                    ],
+                };
+                state[at] = Some(state[at].map_or(bounds, |existing| existing.union(bounds)));
+            }
+        }
+    }
+    let mut patch_visits = 0;
+    let mut within_slice_expansions = 0;
+    let mut support_boundary_hits = 0;
+    for _ in 0..time_slices {
+        let mut next = vec![None::<ReachBox>; state.len()];
+        for source in state.iter().flatten().copied() {
+            let mut swept = source;
+            let mut previous_touched = BTreeSet::new();
+            let endpoint = loop {
+                let (minimum, maximum) = patch_scan_bounds(swept, dimensions);
+                let mut touched = BTreeSet::new();
+                let mut velocity_minimum = [f64::INFINITY; 2];
+                let mut velocity_maximum = [f64::NEG_INFINITY; 2];
+                for y in minimum[1]..maximum[1] {
+                    for x in minimum[0]..maximum[0] {
+                        if !patch_touches_closed_box(x, y, swept) {
+                            continue;
+                        }
+                        let at = lattice_index(x, y);
+                        let Some(bounds) = patch_bounds[at] else {
+                            if patch_overlaps_open_box(x, y, swept)
+                                && !solid_voxel_at(graph, x as i32, y as i32, 0)
+                            {
+                                support_boundary_hits += 1;
+                            }
+                            continue;
+                        };
+                        patch_visits += 1;
+                        touched.insert(at);
+                        for axis in 0..2 {
+                            velocity_minimum[axis] =
+                                velocity_minimum[axis].min(bounds.minimum[axis]);
+                            velocity_maximum[axis] =
+                                velocity_maximum[axis].max(bounds.maximum[axis]);
+                        }
+                    }
+                }
+                if touched.is_empty() {
+                    return Err(ValidationError(
+                        "cellwise remap material reach lost represented support".into(),
+                    ));
+                }
+                let raw_endpoint = ReachBox {
+                    minimum: [
+                        shifted_reach_bound(source.minimum[0], h * velocity_minimum[0], true),
+                        shifted_reach_bound(source.minimum[1], h * velocity_minimum[1], true),
+                    ],
+                    maximum: [
+                        shifted_reach_bound(source.maximum[0], h * velocity_maximum[0], false),
+                        shifted_reach_bound(source.maximum[1], h * velocity_maximum[1], false),
+                    ],
+                };
+                let endpoint = clamp_closed_world_reach(
+                    graph,
+                    closed_sides,
+                    raw_endpoint,
+                    &mut support_boundary_hits,
+                );
+                let expanded = source.union(endpoint);
+                if touched == previous_touched {
+                    break endpoint;
+                }
+                previous_touched = touched;
+                swept = swept.union(expanded);
+                within_slice_expansions += 1;
+                if within_slice_expansions > patch_bounds.len().saturating_mul(time_slices + 1) {
+                    return Err(ValidationError(
+                        "cellwise remap material reach did not close within a time slice".into(),
+                    ));
+                }
+            };
+            let (minimum, maximum) = patch_scan_bounds(endpoint, dimensions);
+            for y in minimum[1]..maximum[1] {
+                for x in minimum[0]..maximum[0] {
+                    if !patch_overlaps_open_box(x, y, endpoint) {
+                        continue;
+                    }
+                    let at = lattice_index(x, y);
+                    let clipped = ReachBox {
+                        minimum: [endpoint.minimum[0].max(x as f64), endpoint.minimum[1].max(y as f64)],
+                        maximum: [
+                            endpoint.maximum[0].min((x + 1) as f64),
+                            endpoint.maximum[1].min((y + 1) as f64),
+                        ],
+                    };
+                    if patch_bounds[at].is_none() {
+                        if !solid_voxel_at(graph, x as i32, y as i32, 0) {
+                            support_boundary_hits += 1;
+                        }
+                        continue;
+                    }
+                    next[at] = Some(next[at].map_or(clipped, |existing| existing.union(clipped)));
+                }
+            }
+        }
+        state = next;
+    }
+    let mut cells = vec![false; graph.cells.len()];
+    for (cell_index, cell) in graph.cells.iter().enumerate() {
+        cells[cell_index] = (cell.minimum[1] as usize..cell.maximum[1] as usize).any(|y| {
+            (cell.minimum[0] as usize..cell.maximum[0] as usize)
+                .any(|x| state[lattice_index(x, y)].is_some())
+        });
+    }
+    Ok(MaterialTraceBand {
+        cells,
+        time_slices,
+        patch_visits,
+        within_slice_expansions,
+        support_boundary_hits,
+    })
+}
