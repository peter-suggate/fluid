  var delta=vec3i(0);delta[axis]=1;
  terms[axis]=(umViscositySite(site+delta,face.axis,face.width,home)-2.0*center+umViscositySite(site-delta,face.axis,face.width,home))/(UM_H()[axis]*UM_H()[axis]*width*width);
