 if(face.width==4u){let page=max(site,umWallLow()>>vec3u(2u))>>vec3u(3u);home=umCoarseOrigin(umBlockOf(page))-(page<<vec3u(3u));}
 let center=umViscositySite(site,face.axis,face.width,home);var terms=vec3f(0);
