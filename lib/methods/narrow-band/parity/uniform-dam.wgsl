 }
}
// ==== particleSurfaceFinish (108-Uniform_narrow-band_FLIP_extended.wgsl)
fn particleSurfaceFinish(home:vec3i,q:vec3i,bulk:f32,nearest2:f32,heat:f32,tiled:bool)->f32{
