 p=tetraOrder(s.x,s.y);s.x=p.x;s.y=p.y;p=tetraOrder(s.z,s.w);s.z=p.x;s.w=p.y;
 p=tetraOrder(s.y,s.z);s.y=p.x;s.z=p.y;
