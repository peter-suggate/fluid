// ==== forcesFineJob (032-Uniform_mixed_forces.wgsl)
fn forcesFineJob(gid:vec3u){
 // With solids bound, launched as a solid-free twin and a general pipeline (umSolidSkip).
 let owner=umAllOwner(gid);if(umSolidSkip()||owner.width!=1u||umOwnerFrozen(owner)){return;}let origin=umOrigin(owner);let at=vec3i(origin);
 let low=umLowOpen(at);
 // Do not query retained solid evidence in the already solid-free twin.
 let solidClear=!umSolidEnabled()||umSolidRegionClearAtBuild(at);
 for(var axis=0u;axis<3u;axis++){if(low[axis]){var q=at;q[axis]-=1;boundary[umLowFaceIndex(origin,axis)]=umLowForced(q,axis);}}
 // The owner's three +faces share its texel (an h owner's +face is never a
 // low face: its anchor is the owner's own stored cell). The drive
 // (viscosity as a vector, capillarity per face) is kept or
 // reused by a COLD region (umForceRetain); gravity and inflow are fresh.
 var value=udLoad_advected(vec3i(at)).xyz;let occupancy=umOccupancy(owner);
 // Gravity on each +face along which it has a component (a uniform: no
 // other axis reads a neighbour), where either cell holds liquid.
 var gravity=vec3<bool>(false);
 for(var axis=0u;axis<3u;axis++){
  if(force.gravity[axis]!=0.0){let neighbor=umFace(owner,axis,1,0u).neighbor;gravity[axis]=occupancy>1e-5||umOccupancy(neighbor)>1e-5||umCoarseMass(neighbor);}
 }
 let retain=umForceRetain(owner);
 if(retain.x==2u){
  for(var axis=0u;axis<3u;axis++){if(gravity[axis]){value[axis]+=force.hDt.w*force.gravity[axis];}}
  value+=umForceKept(retain);
 }else{
  if(occupancy>0.0&&force.physical.z>0.0&&umViscosityExact(owner)){
   let terms=umViscosityTerms(at);
   value+=force.hDt.w*(force.physical.z/force.physical.y)*((terms[0]+terms[1])+terms[2]);
  }
  for(var axis=0u;axis<3u;axis++){if(gravity[axis]){value[axis]+=force.hDt.w*force.gravity[axis];}}
  if(force.physical.w>0.0){
   for(var axis=0u;axis<3u;axis++){
    // A +face inside the owner's tile meets an h owner: its reconstructed
    // gradient is the occupancy difference alone, so equal occupancies (deep
    // liquid, open air) carry no capillary force, closed cells or not.
    var next=at;next[axis]+=1;
    if((at[axis]&3)<3&&umFineOccupancy(next)==occupancy){continue;}
    value[axis]+=umCapillary(owner,umFace(owner,axis,1,0u),solidClear);
   }
  }
  // The kept drive: the evaluation less the advected value and gravity
  // (only a keeping region reloads the advected texel).
  if(retain.x==1u){
   var base=udLoad_advected(vec3i(at)).xyz;for(var axis=0u;axis<3u;axis++){if(gravity[axis]){base[axis]+=force.hDt.w*force.gravity[axis];}}
   let drive=value-base;for(var axis=0u;axis<3u;axis++){umForceKeep(owner,retain,axis,drive[axis]);}
  }
 }
 if(umSourceinflowStrength()>0.0){
  for(var axis=0u;axis<3u;axis++){value[axis]=umInflow(umFace(owner,axis,1,0u),value[axis]);}
 }
 // A +face on a 16h region's high side may meet a frozen cell: it keeps
 // its advected (frozen) value.
 if(UM_COLD_FREEZE){
  let edge=(at&vec3i(15))==vec3i(15);
  if(any(edge)){
   let advectedValue=udLoad_advected(vec3i(at)).xyz;
   for(var axis=0u;axis<3u;axis++){if(edge[axis]){var next=at;next[axis]+=1;if(umFrozenCell(next)){value[axis]=advectedValue[axis];}}}
  }
