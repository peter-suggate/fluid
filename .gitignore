docs/research/

# Benchmark output and write-ups stay local. Files committed before this rule
# stay tracked until removed with git rm --cached.
docs/benchmarks/
docs/verification/

# Paper archives keep the PDF and extracted text; page renders and embedded
# images are regenerated by each archive's extract.py.
docs/papers/narrow-band-flip-2026/**/*.png
docs/papers/narrow-band-flip-2026/**/*.jpg
docs/papers/realtime-particles-2026/**/*.png
docs/papers/realtime-particles-2026/**/*.jpg

# Pool assets: keep editable sources and runtime GLB/FVX exports. These are
# reproducible previews, duplicate packed textures, reports and Blender backups.
assets/pool-party/*preview.blend
assets/pool-party/*.blend[0-9]*
public/assets/pool-party/*.png
public/assets/pool-party/verification.json

# Regenerable Blender garden previews and backups.
assets/hero-garden-blender/*.blend[0-9]*
public/assets/hero-garden-blender/*preview.png
